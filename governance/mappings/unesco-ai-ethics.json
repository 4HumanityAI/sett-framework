      "requirement_id": "paragraph-43",
      "revision": "2",
      "locator": "Paragraph 43",
      "interpretation": "Retain origin links for technical records and keep institutional evidence requirements separately visible; do not label an audit trail as completed institutional accountability.",
      "criterion": "Distinct origins survive even when one technical mechanism contributes to both. Records can identify later human or external evidence requirements without declaring them satisfied.",
      "limits": "SETT provides technical identity and records only. The complete institutional measures, whistle-blower protection, impact assessment and ongoing audit practice are not reduced to a runtime predicate.",
      "approved_sha256": "d1086bab0cc55bf8ab4e83056d029b6f6b3409bc0bd09ccfd1fa2f5141085278",
      "capability": [
        {
          "mechanism": "Distinct origins survive composition and recording, down to the requirements each condition covers.",
          "reference": "docs/decision_records.md",
          "evidence": [
            "tests/test_policy_origins.py::test_related_conditions_keep_their_own_requirements",
            "tests/test_policy_v2_models.py::test_shared_source_preserves_requirements_and_layers"
          ]
        },
        {
          "mechanism": "The governance journal, the trace and recovery keep what happened, including an effect that may or may not have happened.",
          "reference": "docs/governance_recovery.md",
          "evidence": [
            "tests/test_governance_recovery.py::test_a_completed_effect_is_known",
            "tests/test_governance_recovery.py::test_stopped_while_the_handler_runs"
